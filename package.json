{
  "name": "aiportable-justai",
  "version": "0.1.0",
  "description": "AIPortable-JustAI — portable, offline-first local AI assistant (Electron + Ollama)",
  "main": "src/main/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "pack:win": "electron-builder --dir --win",
    "pack:mac": "electron-builder --dir --mac",
    "pack:linux": "electron-builder --dir --linux",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "@fontsource/noto-emoji": "^5.3.2",
    "better-sqlite3": "^13.0.3",
    "mammoth": "^1.8.0",
    "marked": "^12.0.2",
    "pdfjs-dist": "^4.0.379",
    "rtf-parser": "^1.3.3",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.example.aiportable-justai",
    "productName": "AIPortable-JustAI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "portable"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage"
        }
      ],
      "category": "Utility"
    },
    "extraFiles": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "*-models-catalog.json"
        ]
      }
    ],
    "npmRebuild": false
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
